{
  "name": "@aias/red-cliff-record",
  "version": "0.8.2",
  "license": "MIT",
  "author": {
    "name": "Nick Trombley",
    "email": "trombley.nick@gmail.com",
    "url": "https://nicktrombley.design"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Aias/red-cliff-record"
  },
  "bin": {
    "rcr": "./src/server/cli/rcr/index.ts"
  },
  "workspaces": [
    "packages/*",
    "."
  ],
  "type": "module",
  "scripts": {
    "build": "bun run stylegen && bunx --bun vite build",
    "check": "bun run lint && bun run typecheck && bun run format",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "dev": "bun run dev:panda & bun run dev:vite",
    "dev:full": "bun run --filter '*' dev:watch",
    "dev:panda": "panda --watch",
    "dev:vite": "bunx --bun vite",
    "dev:watch": "bunx --bun vite",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --fix .",
    "lint:check": "oxlint .",
    "publish:hozo": "bun publish --cwd packages/hozo",
    "rcr": "bun src/server/cli/rcr/index.ts",
    "start": "bun run server.ts",
    "stylegen": "rm -rf src/app/styled-system && panda codegen && panda cssgen",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch"
  },
  "dependencies": {
    "@base-ui/react": "~1.6.0",
    "@libsql/client": "~0.17.4",
    "@octokit/plugin-throttling": "~11.0.3",
    "@octokit/request-error": "~7.1.1",
    "@octokit/rest": "~22.0.1",
    "@radix-ui/colors": "~3.0.0",
    "@tanstack/react-form": "~1.33.3",
    "@tanstack/react-query": "~5.101.4",
    "@tanstack/react-router": "~1.170.18",
    "@tanstack/react-router-with-query": "~1.130.17",
    "@tanstack/react-start": "~1.168.34",
    "@trpc/client": "~11.18.0",
    "@trpc/react-query": "~11.18.0",
    "@trpc/server": "~11.18.0",
    "@types/bun": "~1.3.14",
    "airtable": "~0.12.2",
    "cmdk": "~1.1.1",
    "colorjs.io": "~0.7.1",
    "dataloader": "~2.2.3",
    "drizzle-orm": "1.0.0-rc.4",
    "lucide-react": "~1.28.0",
    "markdown-it": "~15.0.0",
    "mime-types": "~3.0.2",
    "openai": "~7.3.0",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "react-scan": "~0.5.7",
    "sonner": "~2.0.7",
    "superjson": "~2.2.6",
    "vite": "~8.2.0",
    "zod": "~4.4.3"
  },
  "devDependencies": {
    "@octokit/types": "~16.0.0",
    "@pandacss/dev": "~1.12.0",
    "@rolldown/plugin-babel": "~0.2.3",
    "@types/mime-types": "~3.0.1",
    "@types/node": "~26.1.2",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.4",
    "@vitejs/plugin-react": "~6.0.5",
    "babel-plugin-react-compiler": "~1.0.0",
    "drizzle-kit": "1.0.0-rc.4",
    "oxfmt": "~0.61.0",
    "oxlint": "~1.76.0",
    "oxlint-tsgolint": "~7.0.2001",
    "pg": "~8.22.0",
    "typescript": "~7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "trustedDependencies": [
    "@parcel/watcher"
  ]
}
