{
  "name": "@aias/red-cliff-record",
  "version": "0.9.21",
  "license": "MIT",
  "author": {
    "name": "Nick Trombley",
    "email": "trombley.nick@gmail.com",
    "url": "https://nicktrombley.design"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Aias/red-cliff-record"
  },
  "bin": {
    "rcr": "./src/server/cli/rcr/index.ts"
  },
  "workspaces": [
    "packages/*",
    "."
  ],
  "type": "module",
  "scripts": {
    "build": "bun run stylegen && bunx --bun vite build",
    "check": "bun run lint && bun run typecheck && bun run format",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "dev": "concurrently --kill-others --names panda,zero,vite --prefix-colors yellow,magenta,cyan \"bun run dev:panda\" \"bun run dev:zero\" \"bun run dev:vite\"",
    "dev:full": "bun run --filter '*' dev:watch",
    "dev:panda": "panda --watch",
    "dev:vite": "bunx --bun vite",
    "dev:watch": "bunx --bun vite",
    "dev:zero": "mkdir -p .zero-cache && zero-cache-dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --fix .",
    "lint:check": "oxlint .",
    "publish:hozo": "bun publish --cwd packages/hozo",
    "rcr": "bun src/server/cli/rcr/index.ts",
    "start": "bun run server.ts",
    "start:zero": "mkdir -p .zero-cache && zero-cache",
    "stylegen": "rm -rf src/app/styled-system && panda codegen && panda cssgen",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "zero:generate": "drizzle-zero generate -o src/shared/zero/schema.gen.ts -f",
    "zero:publication": "bun run src/server/db/sync-zero-publication.ts"
  },
  "dependencies": {
    "@base-ui/react": "~1.7.0",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@libsql/client": "~0.17.4",
    "@octokit/plugin-throttling": "~11.0.5",
    "@octokit/rest": "~22.0.1",
    "@radix-ui/colors": "~3.0.0",
    "@rocicorp/zero": "~1.9.0",
    "@tanstack/react-form": "2.0.0-alpha.1",
    "@tanstack/react-query": "~5.102.1",
    "@tanstack/react-router": "~1.170.32",
    "@tanstack/react-router-ssr-query": "~1.167.2",
    "@tanstack/react-start": "~1.168.49",
    "@trpc/client": "~11.18.0",
    "@trpc/server": "~11.18.0",
    "@trpc/tanstack-react-query": "~11.18.0",
    "cmdk": "~1.1.1",
    "colorjs.io": "~0.7.1",
    "dataloader": "~2.2.3",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "4.0.0-rc.112",
    "lucide-react": "~1.33.0",
    "markdown-it": "~15.0.0",
    "mime-types": "~3.0.2",
    "openai": "~7.5.0",
    "postgres": "~3.4.9",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "react-scan": "~0.5.7",
    "sonner": "~2.0.8",
    "superjson": "~2.2.6",
    "vite": "~8.2.2",
    "zod": "~4.5.4"
  },
  "devDependencies": {
    "@octokit/types": "~17.0.0",
    "@pandacss/dev": "~1.12.0",
    "@types/bun": "~1.4.0",
    "@types/mime-types": "~3.0.1",
    "@types/node": "~26.2.0",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.4",
    "@vitejs/plugin-react": "~6.1.0",
    "concurrently": "~10.0.5",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-zero": "~1.0.0-beta.1",
    "oxc-transform-react": "~0.145.0",
    "oxfmt": "~0.64.0",
    "oxlint": "~1.79.0",
    "oxlint-tsgolint": "~7.0.2001",
    "pg": "~8.23.0",
    "typescript": "~7.0.2"
  },
  "engines": {
    "node": ">=26"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@rocicorp/zero-sqlite3"
  ]
}
