{
  "name": "@aias/hozo",
  "version": "0.13.0",
  "description": "Shared schema, relations, and validation for Red Cliff Record",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aias/red-cliff-record.git",
    "directory": "packages/hozo"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev:watch": "tsup src/index.ts --format esm --sourcemap --watch",
    "lint": "oxlint --fix --type-aware . && tsc --noEmit",
    "prepack": "bunx --bun tsup src/index.ts --format esm --sourcemap --clean && bunx --bun tsc -p . --noEmit false --emitDeclarationOnly",
    "test": "bun test"
  },
  "devDependencies": {
    "drizzle-kit": "1.0.0-rc.5",
    "drizzle-orm": "1.0.0-rc.5",
    "tsup": "~9.0.0",
    "typescript": "7.1.0-beta",
    "zod": "~4.6.7"
  },
  "peerDependencies": {
    "drizzle-orm": "1.0.0-rc.5",
    "zod": "~4.6.7"
  }
}
