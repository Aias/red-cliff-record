{
  "name": "@aias/hozo",
  "version": "0.7.0",
  "description": "Shared schema, relations, and validation for Red Cliff Record",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev:watch": "tsup src/index.ts --format esm --sourcemap --watch",
    "lint": "oxlint --fix --type-aware . && tsc --noEmit",
    "prepack": "bunx --bun tsup src/index.ts --format esm --sourcemap --clean && bunx --bun tsc -p . --noEmit false --emitDeclarationOnly",
    "test": "bun test"
  },
  "devDependencies": {
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-orm": "1.0.0-rc.4",
    "tsup": "~8.5.1",
    "typescript": "~7.0.2",
    "zod": "~4.5.4"
  },
  "peerDependencies": {
    "drizzle-orm": "1.0.0-rc.4",
    "zod": "~4.5.4"
  }
}
